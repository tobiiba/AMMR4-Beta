        AnyDrawMuscle drw =  {
          Opacity = 0.25;
          RGB = {1.0, 1.0, 0.0};
        };
        AnyMuscleModel &model = ..MuscleModels.Model_PAMright;
        AnyRefFrame &ins = ....Segments.SimplePelvis.SegPointU;
        AnyRefFrame &orig = ....Segments.SimplePelvis.SegPointD;
      };
      
      AnyMuscleViaPoint PAMleft = {
