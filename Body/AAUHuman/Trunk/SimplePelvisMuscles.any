    // -------------------------------------------------------------------
    // -------------------------- MUSCLE PATHS ---------------------------
    // -------------------------------------------------------------------
    // using via point muscle and color coding to match sketched model
    AnyFolder MusclePaths = {
      
      // -------------------------------
      // Iliococcygeus muscle - ICM
      // -------------------------------
      AnyMuscleViaPoint ICMposteriorright = {
        AnyDrawMuscle drw =  {
          Opacity = 0.25;
          RGB = {0.0, 0.60, 1.0};
        };
        AnyMuscleModel &model = ..MuscleModels.Model_ICMposteriorright;
        AnyRefFrame &ins = ....Segments.PelvisSeg.PICS_ORIGIN.ISCHIALSPINE_R;
        AnyRefFrame &orig = ....Segments.SimplePelvis.SegPointG;
      };

      AnyMuscleViaPoint ICMposteriorleft = {
        AnyDrawMuscle drw =  {
          Opacity = 0.25;
          RGB = {0.0, 0.60, 1.0};
        };
