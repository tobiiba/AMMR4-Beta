/*
  In this file the scaling of the pelvis is defined in order to scale the original pelvis (male) to a fitting female pelvis
  Created with much support of D. Ignasiak

  by default, uniform scaling looks like this for all three dimensions (from ScalingConfig.any):
  AnyVar GeomScale = (...Anthropometrics.SegmentDimensions.PelvisWidth / ..StandardParameters.Pelvis.Width);

  approach to scale for female pelvis:
  multiply original GeomScale with individual factors for depth, height and wight
*/


// Define scaling function for the pelvis
Main.HumanModel.ScalingLaw.GeometricalScaling = {
  AnyFolder SimplePelvis = {

    // import and define parameters needed for scaling
    AnyVar PelvisDepth = PelvisWidth;                                                    // x - antero-posterior    
    AnyVar PelvisHeight = PelvisWidth;                                                   // y - up-down
    AnyVar PelvisWidth = Main.HumanModel.Anthropometrics.SegmentDimensions.PelvisWidth;  // z - left-right
    
    /*
      Factors derived from Kurki, 2011 - European-American sample group - focus on inner pelvic dimensions
      Depth:    H > oulet A-P
      Length:   J > oulet posterior
      Width:    C > inlet M-L
    */
    AnyVar PelvisDepthFactor  = 0.95;   // x, antero-posterior, female pelvis is 9 % deeper, Kurki 2011
    AnyVar PelvisHeightFactor = 0.8;    // y, up-down, female pelvis is 16.7 % higher, Kurki 2011
    AnyVar PelvisWidthFactor  = 1.15;   // z, left-right, female pelvis is 8 % wider, Kurki 2011


    // create customized scaling function for the pelvis
    AnyFolder CustomPelvisScaling = {
      
      
      // make a reference for easier life
      AnyFolder &StandardPelvisParameters = Main.HumanModel.ScalingLaw.StandardParameters.Pelvis;
      
      // find coefficient for each direction
      // X and Z based on inputs, and Y keeping previous approach of scaling to body height 
      AnyVar GeomScaleX = (.PelvisDepth  / StandardPelvisParameters.Width) * .PelvisDepthFactor;    
      AnyVar GeomScaleY = (.PelvisHeight / StandardPelvisParameters.Width) * .PelvisHeightFactor;
      AnyVar GeomScaleZ = (.PelvisWidth  / StandardPelvisParameters.Width) * .PelvisWidthFactor;
      
      // original values - use for comparison with new scaling
      // AnyVar GeomScaleX = 0.9317;
      //  AnyVar GeomScaleY = 0.9317;
      //  AnyVar GeomScaleZ = 0.9317;
      
      AnyFunTransform3DLin ScaleFunction = {
        ScaleMat = diag({.GeomScaleX, .GeomScaleY, .GeomScaleZ});
        AnyMatrix ScaleMatInverse = diag({1/.GeomScaleX, 1/.GeomScaleY, 1/.GeomScaleZ});
        Offset = {0,0,0};
      };
    };
  };
};


// Activate customized scaling for pelvis by linking it to the pelvises custom scale function
Main.HumanModel.Scaling.GeometricalScaling.Pelvis.ScaleFunction = {
  Custom = &Main.HumanModel.ScalingLaw.GeometricalScaling.SimplePelvis.CustomPelvisScaling.ScaleFunction;
};


