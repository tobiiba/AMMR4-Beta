// ---------------- Ligament Paths ----------------
// using via point muscle and color coding to match sketched model
AnyFolder PelvicLigaments = {

  AnyLigamentViaPoint AnococcygealLigament = {
    AnyLigamentModel &model = ..LigamentModels.Model_AnococcygealLig;
    AnyRefFrame &ins = ...Segments.PelvicFloor.BONYPELVIS.COCCYX;
    AnyRefFrame &via = ...Segments.PelvicFloor.SegmentG;
    AnyRefFrame &orig = ...Segments.PelvicFloor.SegmentF;
    AnyDrawPLine drw = {
      Thickness = 1e-3;
      RGB = {0.85, 0.85, 0.85};
    };
  };

  AnyLigamentViaPoint AnalHiatus = {
    AnyLigamentModel &model = ..LigamentModels.Model_AnalHiatus;
    AnyRefFrame &ins = ...Segments.PelvicFloor.SegmentD;
