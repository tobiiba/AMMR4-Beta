      "Main.HumanModel.BodyModel.SelectedOutput.SimplePelvis.Muscles.Act*",
      "Main.HumanModel.BodyModel.SelectedOutput.SimplePelvis.Muscles.Fm*",
      "Main.HumanModel.BodyModel.SelectedOutput.SimplePelvis.Muscles.Ft*",
      "Main.HumanModel.BodyModel.SelectedOutput.SimplePelvis.Muscles.Fp*",
      "Main.HumanModel.BodyModel.SelectedOutput.SimplePelvis.Muscles.Strength*",
      "Main.HumanModel.BodyModel.SelectedOutput.SimplePelvis.LigForce*"
