AnyOutputFile SaveOutputPosition = {
  FileName = "OutputData\ " + .fileID + "_position.csv";
  NumberFormat.Style  = DecimalNumber;
  NumberFormat.Digits = 10;
  Header = {
    ConstSectionOnOff = Off;          // Switch for the header section containing constant variables
    ShortenNamesOnOff = ObjNameShort; // Switch for shortening variable names -> see AnyEnumObjNameTruncation
    VarSectionOnOff   = Off;          // Switch for the variable description section
  };
  Search = {
    "Main.HumanModel.BodyModel.SelectedOutput.SimplePelvis.Segments.Pos*",
  };
};

  AnyOutputFile SaveOutputMusclesLigaments = {
    FileName = "OutputData\ " + .fileID + "_Muscles_Ligaments.csv";
    NumberFormat.Style  = DecimalNumber;
    Header = {
      ConstSectionOnOff = Off;          // Switch for the header section containing constant variables
      ShortenNamesOnOff = ObjNameShort; // Switch for shortening variable names -> see AnyEnumObjNameTruncation
      VarSectionOnOff   = Off;          // Switch for the variable description section
    };
