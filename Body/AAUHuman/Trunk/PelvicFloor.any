// additional segments for insertion and origin points of pelvic floor muscles

AnyFloat Inertia = 1e-7*{0.1, 0.5, 0.5};
AnyFloat RGB = {0.69, 0.69, 0.69};

// vaginal side-wall, right
AnySeg SegmentA = {
  r0 = {0, 0, 0};
  Mass = 0.05;                Jii = .Inertia;
  viewInertia.Visible = On;   viewInertia.RGB = .RGB;

  AnyRefNode NodePUBIS_R = {
    // has the same position as PUBIS_R
    sRel = {..BONYPELVIS.PUBIS_R.sRel[0] - .r0[0],
            ..BONYPELVIS.PUBIS_R.sRel[1] - .r0[1],
            ..BONYPELVIS.PUBIS_R.sRel[2] - .r0[2] };
    // AnyDrawNode drw = {
    //   ScaleXYZ = 0.08*{0.025, 0.025, 0.025};
    //   RGB = {0.0, 0.88, 1.0};
    // };
  }; 
};

