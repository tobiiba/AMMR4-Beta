  r0 = {-1*0.0195, -1*(-0.0023 - .BONYPELVIS.r0[1]), -0.0045};
  Mass = 0.05;                Jii = .Inertia;
  viewInertia.Visible = On;   viewInertia.RGB = .RGB;

  AnyRefNode NodeCOCCYX = {
    // has the same position as COCCYX
    sRel = {-1*(..BONYPELVIS.r0[0] - .r0[0]) + ..BONYPELVIS.COCCYX.sRel[0],
            -1*(..BONYPELVIS.r0[1] - .r0[1]) + ..BONYPELVIS.COCCYX.sRel[1],
            ..BONYPELVIS.r0[2] - .r0[2] + ..BONYPELVIS.COCCYX.sRel[2]        };
    AnyDrawNode drw = {
      ScaleXYZ = 0.05*{0.025, 0.025, 0.025};
      RGB = {0.0, 0.88, 1.0};
    };
  }; 
};

