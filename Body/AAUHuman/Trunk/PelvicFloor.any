// additional segments for insertion and origin points of pelvic floor muscles and ligaments

AnyFloat Inertia = 1e-7*{0.1, 0.5, 0.5};
AnyFloat RGB = {1.0, 0.0, 0.78};

// -------- immoveable segment --------
// immoveable bony pelvis
AnySeg BONYPELVIS = {
  r0 = {0, 1.05, 0};
  Axes0 = RotMat(pi, z); // 180° around z to match PICS
  Mass = 2.0;
  Jii = 0.001*{0.1, 0.1, 0.1};
  viewInertia.Visible = On;   viewInertia.RGB = .RGB;
  viewRefFrame.Visible = On;  viewRefFrame.RGB = .RGB;
  AnyDrawNodes drw = {
    ScaleXYZ = 1e-3*{1, 1, 1};
  };
  
  // immoveable nodes on bony pelvis for muscles and joint connections
  AnyRefNode PUBIS_R         = {  sRel = {-0.0005, -0.0202, 0.0158};  };
  AnyRefNode PUBIS_L         = {  sRel = {-0.0003, -0.0184, -0.0218}; };
  AnyRefNode COCCYX          = {  sRel = {0.0831, -0.0560, 0.0000};   };
  AnyRefNode ISCHIALSPINE_R  = {  sRel = {0.0607, -0.0448, 0.0484};   };
  AnyRefNode ISCHIALSPINE_L  = {  sRel = {0.0601, -0.0443, -0.0586};   };
  // AnyRefNode POINT1          = {  sRel = {0, 0, 0};   };
  // AnyRefNode POINT2          = {  sRel = {0, 0, 0};  };
  // AnyRefNode POINT3          = {  sRel = {0, 0, 0};   };
  // AnyRefNode POINT4          = {  sRel = {0, 0, 0};  };
  // AnyRefNode POINT5          = {  sRel = {0, 0, 0};  };
  // AnyRefNode POINT6          = {  sRel = {0, 0, 0};   };
  // AnyRefNode POINT7          = {  sRel = {0, 0, 0};  };
  // AnyRefNode POINT8          = {  sRel = {0, 0, 0};  };

}; // end of Segment BONYPELVIS

