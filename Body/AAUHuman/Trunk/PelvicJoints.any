// additional joints in pelvic floor to allow movement of moveable segments

AnyFolder PelvicJoints = {

  // ----------------- FIXED BONYPELVIS ON PelvisSeg -----------------
  // this includes all nodes on BONYPELVIS
  AnyStdJoint jBONYPELVIS = {
    AnyRefFrame &Pelvis = ...Segments.PelvisSeg.PelvisSacrumJntNode;
    AnyRefFrame &BONYPELVIS = ...Segments.PelvicFloor.BONYPELVIS;
  };


  // ----------------- MOVEABLE SEGMENTS WITHIN PELVIC FLOOR -----------------
  // these joints connect a node from BONYPELVIS to a moveable segment with a letter (A-G)
  // movement is allowed through joint (AnyPrismaticJoint) and FDK
  AnyPrismaticJoint jSegA = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_R;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentA.NodePUBIS_R;
    Axis = y;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  //   // define springs in the joint for all ForceDep DoF
  //   AnyForce JointStiffness = {
  //     AnyKinLinear &lin = Main.SimplePelvis.Joints.jSegPointA.Linear;
  //     // estimate stiffness through G of LAM (Gachon); A of LAM  5.35 cm^2 (Alperin); l of LAM 10 cm (Gmür)
  //     // D = G * A / L -- in this case for contraction 306 N/m
  //     F = {-306*lin.Pos[0], 0, -306*lin.Pos[2]}; // nummerical value resembles spring constant (F = D * dL)
  //   };
  };

  AnyPrismaticJoint jSegB = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_L;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentB.NodePUBIS_L;
    Axis = y;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyPrismaticJoint jSegC = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.COCCYX;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentC.NodeCOCCYX;
    Axis = y;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyPrismaticJoint jSegD = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_R;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentD.NodePUBIS_R;
    Axis = y;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyPrismaticJoint jSegE = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_L;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentE.NodePUBIS_L;
    Axis = y;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyPrismaticJoint jSegF = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.COCCYX;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentF.NodeCOCCYX;
    Axis = y;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyPrismaticJoint jSegG = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.COCCYX;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentG.NodeCOCCYX;
    Axis = y;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };


  // ----------------- MOVEABLE SEGMENTS ON TENDINOUS ARCH  -----------------
  // these joints connect a node from BONYPELVIS to a moveable segment with a letter (S-Z)
  // movement is only allowed through FDK (AnyStdJoint)

  AnyStdJoint jSegS = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_R;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentS.NodePUBIS_R;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyStdJoint jSegT = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_R;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentT.NodePUBIS_R;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyStdJoint jSegU = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_R;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentU.NodePUBIS_R;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyStdJoint jSegV = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_R;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentV.NodePUBIS_R;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyStdJoint jSegW = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_L;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentW.NodePUBIS_L;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyStdJoint jSegX = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_L;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentX.NodePUBIS_L;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyStdJoint jSegY = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_L;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentY.NodePUBIS_L;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

  AnyStdJoint jSegZ = {
    AnyRefFrame &Pelvis = ...Segments.PelvicFloor.BONYPELVIS.PUBIS_L;
    AnyRefFrame &Seg = ...Segments.PelvicFloor.SegmentZ.NodePUBIS_L;
    // set up FDK with ForceDep constraints for all locked DoF
    // Constraints = {
    //   CType = {ForceDep, ForceDep, Hard, Hard, Hard};
    //   Reaction.Type = {Off, Off, On, On, On};
    // };
  };

}; // -------------------------------------- END OF PELVIC JOINTS
