/*
  In this file all segments of the SimplePelvis model are constrained to the Pelvis.
  Where applicable, FDK constraints are introduced to the joints.

  Separate joints for the individual testcase and calibration are defined 
  (similar to drivers) because calibration requires prescribed motion.
*/

// -------------------------------------------------------------------
// --------------------- TESTCASE JOINTS -----------------------------
// -------------------------------------------------------------------
Main = {

  AnyFolder SimplePelvisJoints = {

    // -------------------------------------------------------------------
    // --------- JOINTS FOR SEGMENTS IN THE CENTER OF THE PELVIS ---------
    // -------------------------------------------------------------------

    // these joints connect a node from BONYPELVIS to a moveable segment with a letter (A-G)
    // movement is allowed through FDK only

    AnyStdJoint jSegA = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointA.NodePUBIS_R;
      // set up FDK with ForceDep constraints for all locked DoF
      Constraints = {
        CType = {ForceDep, ForceDep, ForceDep, Hard, Hard, Hard};
        Reaction.Type = {Off, Off, Off, On, On, On};
      };
      // define springs in the joint for all ForceDep DoF
      AnyForce JointStiffness = {
        AnyKinLinear &lin = Main.SimplePelvisJoints.jSegA.Linear;
        // estimate stiffness through expected descent at valsalva reported by Hsu (1cm with control group)
        // and estimated pressure at valsalva of 15 kPa (max 20kPa acc. to Schünke)
        // calculate area of pelvis from Conjugata Recta (Prometheus) and split force up evenly on all 7 segments
        F = {-1680*lin.Pos[0], -1680*lin.Pos[1], -1680*lin.Pos[2]}; // nummerical value resembles spring constant (F = D * dL)
      };
    };

    AnyStdJoint jSegB = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointB.NodePUBIS_L;
      // set up FDK with ForceDep constraints for all locked DoF
      Constraints = {
        CType = {ForceDep, ForceDep, ForceDep, Hard, Hard, Hard};
        Reaction.Type = {Off, Off, Off, On, On, On};
      };
      // define springs in the joint for all ForceDep DoF
      AnyForce JointStiffness = {
        AnyKinLinear &lin = Main.SimplePelvisJoints.jSegB.Linear;
        // estimate stiffness through expected descent at valsalva reported by Hsu (1cm with control group)
        // and estimated pressure at valsalva of 15 kPa (max 20kPa acc. to Schünke)
        // calculate area of pelvis from Conjugata Recta (Prometheus) and split force up evenly on all 7 segments
        F = {-1680*lin.Pos[0], -1680*lin.Pos[1], -1680*lin.Pos[2]}; // nummerical value resembles spring constant (F = D * dL)
      };
    };

    AnyStdJoint jSegC = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.COCCYX;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointC.NodeCOCCYX;
      // set up FDK with ForceDep constraints for all locked DoF
      Constraints = {
        CType = {ForceDep, ForceDep, ForceDep, Hard, Hard, Hard};
        Reaction.Type = {Off, Off, Off, On, On, On};
      };
      // define springs in the joint for all ForceDep DoF
      AnyForce JointStiffness = {
        AnyKinLinear &lin = Main.SimplePelvisJoints.jSegC.Linear;
        // estimate stiffness through expected descent at valsalva reported by Hsu (1cm with control group)
        // and estimated pressure at valsalva of 15 kPa (max 20kPa acc. to Schünke)
        // calculate area of pelvis from Conjugata Recta (Prometheus) and split force up evenly on all 7 segments
        F = {-1680*lin.Pos[0], -1680*lin.Pos[1], -1680*lin.Pos[2]}; // nummerical value resembles spring constant (F = D * dL)
      };
    };

    AnyStdJoint jSegD = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointD.NodePUBIS_R;
      // set up FDK with ForceDep constraints for all locked DoF
      Constraints = {
        CType = {ForceDep, ForceDep, ForceDep, Hard, Hard, Hard};
        Reaction.Type = {Off, Off, Off, On, On, On};
      };
      // define springs in the joint for all ForceDep DoF
      AnyForce JointStiffness = {
        AnyKinLinear &lin = Main.SimplePelvisJoints.jSegD.Linear;
        // estimate stiffness through expected descent at valsalva reported by Hsu (1cm with control group)
        // and estimated pressure at valsalva of 15 kPa (max 20kPa acc. to Schünke)
        // calculate area of pelvis from Conjugata Recta (Prometheus) and split force up evenly on all 7 segments
        F = {-1680*lin.Pos[0], -1680*lin.Pos[1], -1680*lin.Pos[2]}; // nummerical value resembles spring constant (F = D * dL)
      };
    };

    AnyStdJoint jSegE = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointE.NodePUBIS_L;
      // set up FDK with ForceDep constraints for all locked DoF
      Constraints = {
        CType = {ForceDep, ForceDep, ForceDep, Hard, Hard, Hard};
        Reaction.Type = {Off, Off, Off, On, On, On};
      };
      //  define springs in the joint for all ForceDep DoF
      AnyForce JointStiffness = {
        AnyKinLinear &lin = Main.SimplePelvisJoints.jSegE.Linear;
        // estimate stiffness through expected descent at valsalva reported by Hsu (1cm with control group)
        // and estimated pressure at valsalva of 15 kPa (max 20kPa acc. to Schünke)
        // calculate area of pelvis from Conjugata Recta (Prometheus) and split force up evenly on all 7 segments
        F = {-1680*lin.Pos[0], -1680*lin.Pos[1], -1680*lin.Pos[2]}; // nummerical value resembles spring constant (F = D * dL)
      };
    };

    AnyStdJoint jSegF = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.COCCYX;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointF.NodeCOCCYX;
      // set up FDK with ForceDep constraints for all locked DoF
      Constraints = {
        CType = {ForceDep, ForceDep, ForceDep, Hard, Hard, Hard};
        Reaction.Type = {Off, Off, Off, On, On, On};
      };
      // define springs in the joint for all ForceDep DoF
      AnyForce JointStiffness = {
        AnyKinLinear &lin = Main.SimplePelvisJoints.jSegF.Linear;
        // estimate stiffness through expected descent at valsalva reported by Hsu (1cm with control group)
        // and estimated pressure at valsalva of 15 kPa (max 20kPa acc. to Schünke)
        // calculate area of pelvis from Conjugata Recta (Prometheus) and split force up evenly on all 7 segments
        F = {-1680*lin.Pos[0], -1680*lin.Pos[1], -1680*lin.Pos[2]}; // nummerical value resembles spring constant (F = D * dL)
      };
    };

    AnyStdJoint jSegG = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.COCCYX;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointG.NodeCOCCYX;
      // set up FDK with ForceDep constraints for all locked DoF
      Constraints = {
        CType = {ForceDep, ForceDep, ForceDep, Hard, Hard, Hard};
        Reaction.Type = {Off, Off, Off, On, On, On};
      };
      // define springs in the joint for all ForceDep DoF
      AnyForce JointStiffness = {
        AnyKinLinear &lin = Main.SimplePelvisJoints.jSegG.Linear;
        // estimate stiffness through expected descent at valsalva reported by Hsu (1cm with control group)
        // and estimated pressure at valsalva of 15 kPa (max 20kPa acc. to Schünke)
        // calculate area of pelvis from Conjugata Recta (Prometheus) and split force up evenly on all 7 segments
        F = {-1680*lin.Pos[0], -1680*lin.Pos[1], -1680*lin.Pos[2]}; // nummerical value resembles spring constant (F = D * dL)
      };
    };

    // -------------------------------------------------------------------
    // ------------ JOINTS FOR SEGMENTS ON THE TENDINOUS ARCH ------------
    // -------------------------------------------------------------------

    // these joints connect a node from PICS_ORIGIN to a moveable segment with a letter (S-Z)
    // movement is only allowed through FDK (AnyStdJoint) if at all
    AnyStdJoint jSegS = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointS.NodePUBIS_R;
    };

    AnyStdJoint jSegT = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointT.NodePUBIS_R;
    };

    AnyStdJoint jSegU = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointU.NodePUBIS_R;
    };

    AnyStdJoint jSegV = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointV.NodePUBIS_R;
    };

    AnyStdJoint jSegW = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointW.NodePUBIS_L;
    };

    AnyStdJoint jSegX = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointX.NodePUBIS_L;
    };

    AnyStdJoint jSegY = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointY.NodePUBIS_L;
    };

    AnyStdJoint jSegZ = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointZ.NodePUBIS_L;
    };

    // ---------------------------------------------- END OF JOINTS ON TENDINOUS ARCH

  }; // ---------------------------------------------- END OF FOLDER SimplePelvisJoints
  
}; // ---------------------------------------------- END OF TESTCASE JOINTS OF PELVIC FLOOR




// -------------------------------------------------------------------
// -------------------- CALIBRATION JOINTS ---------------------------
// -------------------------------------------------------------------
Main = {

  AnyFolder SimplePelvisCalibrationJoints = {

    // -------------------------------------------------------------------
    // --------- JOINTS FOR SEGMENTS IN THE CENTER OF THE PELVIS ---------
    // -------------------------------------------------------------------

    // these joints connect a node from BONYPELVIS to a moveable segment with a letter (A-G) - no FDK required

    AnyPrismaticJoint jSegA = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointA.NodePUBIS_R;
       Axis = y;
    };

    AnyPrismaticJoint jSegB = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointB.NodePUBIS_L;
      Axis = y;
    };

    AnyPrismaticJoint jSegC = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.COCCYX;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointC.NodeCOCCYX;
      Axis = y;
    };

    AnyPrismaticJoint jSegD = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointD.NodePUBIS_R;
      Axis = y;
    };

    AnyPrismaticJoint jSegE = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointE.NodePUBIS_L;
      Axis = y;
    };

    AnyPrismaticJoint jSegF = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.COCCYX;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointF.NodeCOCCYX;
      Axis = y;
    };

    AnyPrismaticJoint jSegG = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.COCCYX;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointG.NodeCOCCYX;
      Axis = y;
    };

    // -------------------------------------------------------------------
    // ------------ JOINTS FOR SEGMENTS ON THE TENDINOUS ARCH ------------
    // -------------------------------------------------------------------

    // these joints connect a node from PICS_ORIGIN to a moveable segment with a letter (S-Z)
    // movement is only allowed through FDK (AnyStdJoint) if at all
    AnyStdJoint jSegS = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointS.NodePUBIS_R;
    };

    AnyStdJoint jSegT = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointT.NodePUBIS_R;
    };

    AnyStdJoint jSegU = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointU.NodePUBIS_R;
    };

    AnyStdJoint jSegV = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_R;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointV.NodePUBIS_R;
    };

    AnyStdJoint jSegW = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointW.NodePUBIS_L;
    };

    AnyStdJoint jSegX = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
      AnyRefFrame &Seg = Main.HumanModel.BodyModel.Trunk.Segments.SimplePelvis.SegPointX.NodePUBIS_L;
    };

    AnyStdJoint jSegY = {
      AnyRefFrame &Pelvis = Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN.PUBIS_L;
