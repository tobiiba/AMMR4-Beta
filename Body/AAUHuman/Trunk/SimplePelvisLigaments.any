        AnyRefFrame &via = .....Segments.SimplePelvis.SegPointG;
        AnyRefFrame &orig = .....Segments.SimplePelvis.SegPointF;
        AnyDrawPLine drw = {  Thickness = ..Thickness;          RGB = ..RGB;        };
      };

      AnyLigamentViaPoint AnalHiatus = {
        AnyLigamentModel &model = ..LigamentModels.Model_AnalHiatus;
        AnyRefFrame &ins = .....Segments.SimplePelvis.SegPointD;
