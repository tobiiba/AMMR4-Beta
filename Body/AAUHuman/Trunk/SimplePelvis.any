

// -------------------------------------------------------------------
// ---------------------- LOCAL REFERENCE FRAME ----------------------
// -------------------------------------------------------------------

Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg = {
  AnyRefNode PICS_ORIGIN = {
    sRel = {0.074, -0.161, 0};
    ARel = RotMat(189.3*pi/180, z);
    viewRefFrame.Visible = On;
    viewRefFrame.RGB = {1.0, 0.0, 0.78};
    viewRefFrame.ScaleXYZ = {1, 1, 1};
  };

  // Sacrococcygeal joint to calculate angle of SCIPP line relative to horizontal plane of
  // global reference system - difference to 34 degrees must be added to ARel of PICS_ORIGIN
  AnyRefNode SCIPP            = { sRel = {-0.041, -0.108, 0};         };
}; // ---------------------- END OF LOCAL REFERENCE FRAME ----------------------



// -------------------------------------------------------------------
// ---------------------- NODES ON LOCAL REF FRAME -------------------
// -------------------------------------------------------------------
Main.HumanModel.BodyModel.Trunk.Segments.PelvisSeg.PICS_ORIGIN = {
