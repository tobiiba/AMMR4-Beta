    // coccyx adjusted to tip of coccyx by straight length of coccyx (Woon, 2012) and assumed angle of 60° from horizontal plane
    ARel = .ARel'; // invert rotation matrix (according to Dominika)
  };

  AnyRefNode ISCHIALSPINE_R   = { sRel = {0.0607, -0.0448, 0.0484};   ARel = .ARel';  };
  AnyRefNode ISCHIALSPINE_L   = { sRel = {0.0601, -0.0443, -0.0586};  ARel = .ARel';  };
  AnyRefNode POINT1           = { sRel = {0.0003, -0.0248, 0.0208};   ARel = .ARel';  };
  AnyRefNode POINT2           = { sRel = {0.0011, -0.0295, 0.0258};   ARel = .ARel';  };
  AnyRefNode POINT3           = { sRel = {0.0019, -0.0342, 0.0308};   ARel = .ARel';  };
  AnyRefNode POINT4           = { sRel = {0.0301, -0.0428, 0.0448};   ARel = .ARel';  };
  AnyRefNode POINT5           = { sRel = {0.0005, -0.0233, -0.0272};  ARel = .ARel';  };
  AnyRefNode POINT6           = { sRel = {0.0013, -0.0282, -0.0326};  ARel = .ARel';  };
  AnyRefNode POINT7           = { sRel = {0.0021, -0.0331, -0.0380};  ARel = .ARel';  };
  AnyRefNode POINT8           = { sRel = {0.0291, -0.0425, -0.0525};  ARel = .ARel';  };

}; // ---------------------- END OF NODES ON LOCAL REF FRAME -------------------



