/*
  In this file all drivers of the SimplePelvis model are defined.
  The number of drivers and their properties are determined by
  the given joints of the pelvic floor segments in SimplePelvisJoints.any.
    cranial movement  -->  -y

  separate drivers for the individual testcases and calibration are defined
*/


// reference all drivers of Thoracic.main which are not within the body model in this folder to be added to the study
Main = {
  AnyFolder ThoracicDrivers = {
    AnyKinEqSimpleDriver &MannequinDriver1 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverPosX;
    AnyKinEqSimpleDriver &MannequinDriver2 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverPosY;
    AnyKinEqSimpleDriver &MannequinDriver3 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverPosZ;
    AnyKinEqSimpleDriver &MannequinDriver4 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverRotZ;
    AnyKinEqSimpleDriver &MannequinDriver5 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverRotY;
    AnyKinEqSimpleDriver &MannequinDriver6 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverRotX;

    // Add a driver which drives the whole spine. The spine rhythms handles the individual DOFs, but rhytms can be disabled
    // for full control of all DOFs. -- was moved from Study to here to keep it tidy
    SimpleFourierDriver Trunk_Extension = {
      AnyKinMeasure &ref1 = Main.HumanModel.BodyModel.Interface.Trunk.PelvisThoraxExtension;
      RangeOfMotion = {0, 0}*pi/180;
      Freq = 1/(Main.Study.tEnd-Main.Study.tStart);
      Phase = 0*pi/180;
      Reaction.Type ={Off};
    };
    SimpleFourierDriver Trunk_LateralBending = {
      AnyKinMeasure &ref2 = Main.HumanModel.BodyModel.Interface.Trunk.PelvisThoraxLateralBending;
      RangeOfMotion = {0, 0} *pi/180;
      Freq = 0.5/(Main.Study.tEnd-Main.Study.tStart);
      Phase = 180 *pi/180;
      Reaction.Type ={Off};
    };
    SimpleFourierDriver Trunk_AxialRotation = {
      AnyKinMeasure &ref3 = Main.HumanModel.BodyModel.Interface.Trunk.PelvisThoraxRotation;
      RangeOfMotion = {0, 0} *pi/180;
      Freq = 0.25/(Main.Study.tEnd-Main.Study.tStart);
      Phase = 0 * pi/180;
      Reaction.Type ={Off};
    };
  };
};

