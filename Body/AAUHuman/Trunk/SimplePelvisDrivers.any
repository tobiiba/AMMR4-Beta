  // -------------------------------------------------------------------
  // --------------------- CALIBRATION DRIVERS -------------------------
  // -------------------------------------------------------------------

  // these drivers should not be changed because they have an impact on the parameters Lf0 and Lt0 of the calibrated muscles
  Main = {
    AnyFolder SimplePelvisCalibrationDrivers = {
      AnyKinEqSimpleDriver ActuatorA = {

        AnyKinMeasure &jnt = Main.SimplePelvisCalibrationJoints.jSegA;
        DriverPos = {0.005};
        DriverVel = {-0.01}; // mm/s
        Reaction.Type = {Off};
      };

      AnyKinEqSimpleDriver ActuatorB = {
        AnyKinMeasure &jnt = Main.SimplePelvisCalibrationJoints.jSegB;
        DriverPos = {0.005};
        DriverVel = {-0.01}; // mm/s
        Reaction.Type = {Off};
      };

      AnyKinEqSimpleDriver ActuatorC = {
        AnyKinMeasure &jnt = Main.SimplePelvisCalibrationJoints.jSegC;
        DriverPos = {0.02};
        DriverVel = {-0.03}; // mm/s
        Reaction.Type = {Off};
      };

      AnyKinEqSimpleDriver ActuatorD = {
        AnyKinMeasure &jnt = Main.SimplePelvisCalibrationJoints.jSegD;
        DriverPos = {0.02};
        DriverVel = {-0.03}; // mm/s
        Reaction.Type = {Off};
      };

      AnyKinEqSimpleDriver ActuatorE = {
        AnyKinMeasure &jnt = Main.SimplePelvisCalibrationJoints.jSegE;
        DriverPos = {0.02};
        DriverVel = {-0.03}; // mm/s
        Reaction.Type = {Off};
      };

      AnyKinEqSimpleDriver ActuatorF = {
        AnyKinMeasure &jnt = Main.SimplePelvisCalibrationJoints.jSegF;
        DriverPos = {0.02};
        DriverVel = {-0.03}; // mm/s
        Reaction.Type = {Off};
