// -------------------------------------------------------------------
// -------------------- BASE VERSION SIMPLEPELVIS --------------------
// -------------------------------------------------------------------

#include "../libdef.any"
#include "<ANYBODY_PATH_MODELUTILS>/Drivers/Fourier.any"


Main = {
 
  ///////////////////////////////////////////////////
  // Body Model Configuration. 
  // This would often be located in a seperate 
  // file (BodyModelConfig.any) in other examples
  ///////////////////////////////////////////////////
  
  // New flexible thorax is enabled with:
  // #define BM_TRUNK_THORACIC_MODEL _THORACIC_MODEL_RIGID_
  #define BM_TRUNK_THORACIC_MODEL _THORACIC_MODEL_FLEXIBLE_
  
  // only head, thorax and pelvis required
  #define BM_LEG_MODEL OFF
  #define BM_ARM_LEFT OFF
  #define BM_ARM_RIGHT OFF
  
  // Note: Model doesn't yet work without muscles
  #define BM_TRUNK_MUSCLES ON
  
  // The new thoracic model comes with a full set of
  // ligaments all along the spine. They can be enabled
  // with the following switch.
  #define BM_TRUNK_LIGAMENTS OFF
  
  // Set scaling of pelvic floor
  #define BM_SCALING _SCALING_UNIFORM_

  // This example comes with custom fourier drivers for the
  // spine motion. So here we disable the default drivers 
  #define BM_MANNEQUIN_DRIVER_PELVIS_THORAX_EXTENSION OFF
  #define BM_MANNEQUIN_DRIVER_PELVIS_THORAX_ROTATION OFF
  #define BM_MANNEQUIN_DRIVER_PELVIS_THORAX_LATERAL_BENDING OFF
  
  // Disable neck drivers and link the degrees of freedom to the 
  // rest of the spine. 
  #define BM_MANNEQUIN_DRIVER_SKULL_THORAX_FLEXION OFF
  #define BM_MANNEQUIN_DRIVER_SKULL_THORAX_LATERALBENDING OFF
  #define BM_MANNEQUIN_DRIVER_SKULL_THORAX_ROTATION OFF
  #define BM_TRUNK_CERVICAL_THORACIC_LINK ON
  
  

  // -------------------------------------------------------------------
  // --------------------------- SIMPLEPELVIS --------------------------
  // -------------------------------------------------------------------

  /*
    Here, all structures and parameters for the SimplePelvis model will be initiated
    comment-out both lines below to deactivate SimplePelvis model
  */

  #define BM_SIMPLEPELVIS ON 
  #include "<ANYBODY_PATH_BODY>/Trunk/SimplePelvis.any"

  // -------------------------------------- END OF SIMPLEPELVIS SETUP
  
   
  // Include the human model
  #include "<ANYBODY_PATH_BODY>/HumanModel.any"

  AnyFolder Model = {
     AnyFolder& BodyModel = Main.HumanModel.BodyModel;
     AnyFolder& DefaultDrivers = Main.HumanModel.DefaultMannequinDrivers;
     
     AnyReacForce PelvisGroundReactions = {
       AnyKinMeasure& lin = .BodyModel.Interface.Trunk.PelvisPosX.lin;
       AnyKinMeasure& rot = .BodyModel.Interface.Trunk.PelvisRotX.rot;
     };
  };
  

  // -------------------------------------------------------------------
  // ------------------------------- STUDY -----------------------------
  // -------------------------------------------------------------------
  AnyBodyStudy Study = {
    AnyFolder& Model = Main.Model;
    InverseDynamics.Criterion.UpperBoundOnOff = Off;
    // InverseDynamics.ForceDepKinOnOff = On; // command Study to apply FDK during InverseDynamics
    InverseDynamics.Criterion.Type = MR_MinMaxStrict; // MuscleRecruitment algorithm -- default MR_Polynomial
    
    tStart = 0;
    tEnd = 1;
    Gravity = {0, -9.81, 0.0};
    nStep = 5;
    
    AnyVar PelvisThoraxFlexionDeg = Main.HumanModel.BodyModel.Interface.Trunk.PelvisThoraxExtension.Pos[0]*180/pi;

    AnyFolder& BodyModel = Main.HumanModel.BodyModel;

    // TBD - add drivers from Study and DefaultMannequinDrivers to BodyModel.Trunk for calibration
    Main.HumanModel.BodyModel.Trunk = {
      AnyFolder AddDrivers = {
        AnyKinEqSimpleDriver &MannequinDriver1 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverPosX;
        AnyKinEqSimpleDriver &MannequinDriver2 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverPosY;
        AnyKinEqSimpleDriver &MannequinDriver3 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverPosZ;
        AnyKinEqSimpleDriver &MannequinDriver4 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverRotZ;
        AnyKinEqSimpleDriver &MannequinDriver5 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverRotY;
        AnyKinEqSimpleDriver &MannequinDriver6 = Main.HumanModel.DefaultMannequinDrivers.PelvisGroundDriverRotX;
        AnyKinEqFourierDriver &StudyDriver1 = Main.Study.Trunk_Extension;
        AnyKinEqFourierDriver &StudyDriver2 = Main.Study.Trunk_LateralBending;
        AnyKinEqFourierDriver &StudyDriver3 = Main.Study.Trunk_AxialRotation;
      };
    };
    // End of TBD


    // Add a driver which drives the whole spine.
    // The spine rhythms handles the individual DOFs, but rhytms can be disabled
    // for full control of all DOFs.
    SimpleFourierDriver Trunk_Extension = {
       AnyKinMeasure &ref1 = .BodyModel.Interface.Trunk.PelvisThoraxExtension;
       RangeOfMotion = {0, 0}*pi/180;
       Freq = 1/(Main.Study.tEnd-Main.Study.tStart);
       Phase = 0*pi/180;
       Reaction.Type ={Off};
    };
    
    SimpleFourierDriver Trunk_LateralBending = {
       AnyKinMeasure &ref2 = .BodyModel.Interface.Trunk.PelvisThoraxLateralBending;
       RangeOfMotion = {0,0};
       Freq = 0.5/(Main.Study.tEnd-Main.Study.tStart);
       Phase = 180 *pi/180;
       Reaction.Type ={Off};
    };

    SimpleFourierDriver Trunk_AxialRotation = {
       AnyKinMeasure &ref3 = .BodyModel.Interface.Trunk.PelvisThoraxRotation;
       RangeOfMotion = {0,0};
       Freq = 0.25/(Main.Study.tEnd-Main.Study.tStart);
       Phase = 0 * pi/180;    
       Reaction.Type ={Off};
    };
    

    // Include functions to generate a video:
    // -> Run `Study.VideoTool.Preview` to preview the camera view.
    // -> Run `Study.VideoTool.Create_Video` to generate video from the analysis.
    #include "CreateVideo.any" 
  };


  // -------------------------------------------------------------------
  // -------------------- ADDITIONAL OPERATIONS ------------------------
  // -------------------------------------------------------------------

  // A new calibration study
  AnyBodyCalibrationStudy CalibrationStudy = {
    AnyFolder &Model = Main.HumanModel.BodyModel;
    // AnyFolder &Drivers = Main.CalibrationDrivers;
    nStep = 1;
    
   MuscleArr = {
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.ICMposteriorright,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.ICMposteriorleft,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.ICManteriorright,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.ICManteriorleft,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.PPMright,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.PPMleft,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.PAMright,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.PAMleft,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.PVaMright,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.PVaMleft,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.PRMright,
     &Main.HumanModel.BodyModel.Trunk.Muscles.SimplePelvisMuscles.MusclePaths.PRMleft
   };
   
   LigamentArr = {
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.AnococcygealLigament,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.AnalHiatus,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.UrogenitalHiatus,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TendinousArchR,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TendinousArchL,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TA1,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TA2,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TA3,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TA4,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TA5,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TA6,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TA7,
     &Main.HumanModel.BodyModel.Trunk.ElasticElements.Ligaments.SimplePelvisLigaments.LigamentPaths.TA8
   };
  }; // End of calibration study

  AnyOperationSequence SimplePelvisCalibration = {
    AnyOperation& op1 = Main.CalibrationStudy.FiberAndTendonLengthAdjustment;
    AnyOperation& op2 = Main.CalibrationStudy.LigamentLengthAdjustment;
    AnyOperation& ref = Main.Study.InitialConditions;
  };

  // AnyOperationSequence RunApplication = {
  //   AnyOperation& ref = Main.Study.InverseDynamics;
  // };
    
  AnyOperationSequence ModelSetUp = {
    AnyOperation& ref = Main.Study.InitialConditions;
  };
  
};
  